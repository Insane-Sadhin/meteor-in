# METEOR-IN National Weather Data Intelligence Platform Configuration

PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Leave blank to use built-in PostgreSQL WASM storage (data/meteor.db)
# Or provide standard PostgreSQL connection string: postgresql://postgres:password@localhost:5432/meteor
DATABASE_URL=

# Open-Meteo Configuration (Primary Source - Free, No Key Required)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_POLL_INTERVAL_MS=300000

# OpenAQ Configuration (Environmental Data - Requires API Key)
# Sign up at https://openaq.org to obtain key
OPENAQ_API_KEY=
OPENAQ_POLL_INTERVAL_MS=600000

# OpenWeather Configuration (Secondary Provider - Optional)
# Sign up at https://openweathermap.org to obtain key
OPENWEATHER_API_KEY=

# Ingestion Settings
DEMO_FALLBACK_ENABLED=true
MAX_RETRY_ATTEMPTS=3
REQUEST_TIMEOUT_MS=8000
